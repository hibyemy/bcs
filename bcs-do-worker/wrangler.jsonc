{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bcs-do-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-28",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "HUB",
				"class_name": "MultiplayerHub"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["MultiplayerHub"]
		}
	]
}